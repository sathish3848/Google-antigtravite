# Google Gemini API Key (Get yours from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Default Gemini model (Defaults to gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-3.7-flash, gemini-3.5-flash, gemini-flash-latest, gemma-4-26b-a4b-it
GEMINI_MODEL=gemini-3.8-flash

# Optional: Default embedding model
EMBEDDING_MODEL=models/gemini-embedding-001
